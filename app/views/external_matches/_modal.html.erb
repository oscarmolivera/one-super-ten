<turbo-frame id="external-match-modal-frame">
  <div id="externalMatchModal" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">
            <%= external_match.new_record? ? "Nuevo Partido" : "Editar Partido" %>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <turbo-frame id="new_external_match_form">
            <%= render "external_matches/form", external_match: @external_match, tournament: @tournament, season_team: @season_team %>
          </turbo-frame>
        </div>
      </div>
    </div>
  </div>
  <script type="module">
    const modalEl = document.querySelector('#externalMatchModal')
    if (modalEl) {
      document.body.appendChild(modalEl)
      const modal = new bootstrap.Modal(modalEl)
      modal.show()
      modalEl.addEventListener('hide.bs.modal', () => {
        if (document.activeElement) {
          document.activeElement.blur() // Blur before hiding
        }
      }, { once: true })
      window.closeMatchModal = () => modal.hide()
    }
  </script>
</turbo-frame>