<%= turbo_stream.append "external_matches_#{@tournament.id}", partial: "external_matches/external_match", locals: { external_match: @external_match } %>
<%= turbo_stream.replace "standings_#{@tournament.id}", partial: "season_teams/standings_table", locals: { tournament_data: { standings: @tournament.standings.order(position: :asc).reload, tournament: @tournament } } %>
<%= turbo_stream.update "addExternalMatchModal" do %>
  <div class="modal fade" id="addExternalMatchModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Agregar Resultado Externo</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <%= render "external_matches/form", external_match: ExternalMatch.new, tournament: @tournament %>
        </div>
      </div>
    </div>
  </div>
<% end %>
<%= turbo_stream.prepend "flash_messages" do %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    Resultado agregado exitosamente.
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% end %>