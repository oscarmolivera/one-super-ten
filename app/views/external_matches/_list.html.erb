<div class="card-body">
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <tr>
        <th class="fw-light" scope="col">Fecha</th>
        <th class="fw-light" scope="col">Partido</th>
        <th class="fw-light" scope="col">Marcador</th>
        <th class="fw-light" scope="col">Notas</th>
      </tr>
    </thead>
    <tbody id="external_matches_list">
      <% matches = external_match.order(match_date: :desc) %>
      <% if matches.any? %>
        <% matches.each do |external_match| %>
          <%= render "external_matches/external_match", external_match: external_match %>
        <% end %>
      <% else %>
        <tr>
          <td colspan="4" class="text-center">Sin resultados registrados.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

