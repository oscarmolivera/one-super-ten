<div id="matches_display">
  <% matches = (stage_matches && stage_matches[:matches_by_stage]&.first&.[](:matches) || []).select { |match| match.stage.phase == phase_name } %>
  <% matches.each do |match| %>
    <div class="row" id="<%= dom_id(match) %>">
      <div class="col-md-5">
        <div class="container">
          <!-- Bootstrap Card -->
          <div class="card shadow">
            <!-- Card Header -->
            <div class="card-header d-flex justify-content-between align-items-center <%= card_header_style(match) %>">
              <%= display_plays_as_badge(match) %>
              <div class="d-flex align-items-center">
                <%= image_tag 'vendor/stadium.svg', class: 'avatar-lg px-md-5', alt: '...' %>
                <%= match.location %>
                <%= "#{match.id} | #{match.stage.id}" %>
              </div>
              <div class="ms-auto">
                <%= display_status_badge(match.status) %>
              </div>
            </div>

            <!-- Card Body -->
            <div class="card-body <%= card_body_style(match) %>">
              <div class="row text-center align-items-center">
                <!-- Home Team -->
                <div class="col-4">
                  <%= display_home_team_logo_and_name(match, show_highlights: true, season_team: season_team) %>
                </div>

                <!-- Match Details -->
                <div class="col-4">
                  <%= display_match_schedule(match)%>
                  <div class="h1">
                    <%= display_match_result(match) %>
                  </div>
                  <% unless match.status == 3 %>
                    <div class="text-warning fw-bold"><%= tournament_data[:category].rule_value(:category_match_duration) %> minutos</div>
                    <div class="text-muted small mt-2">
                      Arbitro Principal: <strong><%= match.referee.present? ? match.referee : "Sin Información" %></strong>
                    </div>
                  <% end %>
                  <%= match_action_buttons(season_team, match) %>
                </div>

                <!-- Away Team -->
                <div class="col-4">
                  <%= display_away_team_logo_and_name(match, show_highlights: true, season_team: season_team) %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-7">
        <turbo-frame id="call_up_frame_<%= match.id %>"
                     data-controller="frame-closer call-up-cleaner"
                     <% if match.call_up.present? %>
                       data-call-up-cleaner-call-up-id-value="<%= match.call_up.id %>"
                       data-call-up-cleaner-button-id-value="call_up_button_<%= match.id %>"
                     <% end %>>
        </turbo-frame>
        <turbo-frame id="performance_frame_<%= match.id %>" data-controller="frame-closer"></turbo-frame>
      </div>
    </div>
  <% end %>
  <% if matches.empty? %>
    <div class="alert alert-info text-center mb-0">
      No hay partidos en la fase <%= phase_name.humanize %>.
    </div>
  <% end %>
</div>