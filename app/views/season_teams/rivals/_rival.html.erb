<div class="col" id="<%= dom_id(rival) %>">
  <div class="card shadow-sm border text-center p-3 d-flex flex-column justify-content-between <%= rival_card_height(policy(rival).update?) %> <%= 'inactive-rival-card' unless tournament_active?(rival) %>">
    <div>
      <div class="mb-2">
        <%= rival_team_logo(rival, class: "mx-auto d-block mb-2") %>
      </div>
      <div class="mb-2 px-2">
        <div class="fw-semibold text-dark text-truncate" title="<%= rival.name %>">
          <%= rival.name %>
          <% unless tournament_active?(rival) %>
            <span class="badge bg-warning ms-2">Retirado de Torneo</span>
          <% end %>
        </div>
        <div class="text-muted small text-truncate" title="<%= rival.location %>">
          <%= rival.location %>
        </div>
      </div>
    </div>

    <div class="d-flex justify-content-center gap-2 mt-2">
      <% if @season_team&.active %>
        <% if policy(rival).update? %>
          <button type="button"
                  class="btn btn-sm btn-outline-primary"
                  data-controller="modal-loader"
                  data-action="click->modal-loader#load"
                  data-modal-loader-url-value="<%= edit_rival_path(rival, season_team_id: @season_team.id) %>"
                  data-modal-loader-target-frame-value="#editRivalModal-<%= rival.id %>">
            <i class="fa fa-pencil-alt"></i>
          </button>
          <turbo-frame id="editRivalModal-<%= rival.id %>"></turbo-frame>
        <% end %>

        <% if policy(rival).destroy? %>
          <%= button_to rival_path(rival, season_team_id: @season_team.id),
              method: :delete,
              class: "btn btn-sm btn-outline-danger",
              form: { data: { turbo_confirm: "¿Eliminar rival?" } } do %>
            <i class="fa fa-times"></i>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
