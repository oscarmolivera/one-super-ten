<div class="tab-pane" id="matches" role="tabpanel">
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
      <h5 class="mb-0">
        <i class="fa-solid fa-trophy me-2"></i> Partidos del Torneo
      </h5>   
    </div>

    <div class="bg-body-tertiary border-bottom py-2 px-3 small text-muted d-flex align-items-center">
      <i class="fa-solid fa-layer-group me-2"></i>
      <span>Fases del torneo: gestiona el avance de cada fase y revisa sus partidos.</span>
    </div>    

    <%= render_tournament_stages(@tournament_data, @season_team) %>
  </div>

    <turbo-frame id="match_modal_frame"></turbo-frame>
</div>
<style>
  /* 1) No fake line under the pills */
  .tabs-wrap .nav-pills { margin-bottom: 0; }
  .tabs-wrap .nav-pills::after { content: none; }

  /* 2) Real, continuous box for the content */
  .tabcontent-border {
    border: 1px solid var(--bs-border-color, #dee2e6);
    /* we DO want the top border now */
    border-radius: .5rem;               /* rounded corners all around */
    margin-top: 0;                       /* sit flush under the pills */
    position: relative;
    z-index: 1;
    padding-top: 15px;
  }

  /* 3) Make the active pill “merge” with the box */
  .nav-pills .nav-link {
    border: 1px solid transparent;
    border-bottom: 0;
    border-radius: .5rem .5rem 0 0;
    position: relative;
    background: transparent;
    z-index: 2;                          /* above the box border */
  }

  .nav-pills .nav-link.active {
    background: #fff;                    /* same as content bg */
    border-color: var(--bs-border-color, #dee2e6);
    border-bottom-color: #fff;           /* visually merges with content */
  }

  /* This masks the tab-content’s top border right under the active pill */
  .nav-pills .nav-link.active::after {
    content: "";
    position: absolute;
    left: -1px;                          /* cover its own left border too */
    right: -1px;                         /* and right border */
    bottom: -1px;                        /* sits over the tab-content top border */
    height: 1px;
    background: #fff;                    /* same as .tabcontent-border background */
    z-index: 3;
  }

  #match_modal_frame { position: relative; z-index: 1060; }
</style>