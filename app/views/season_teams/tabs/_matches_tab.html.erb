<div class="tab-pane" id="matches" role="tabpanel">
  <div class="card shadow-sm border-0 mb-4" data-controller="tournament-match-stages">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
      <h5 class="mb-0">
        <i class="fa-solid fa-trophy me-2"></i> Partidos del Torneo
      </h5>
      <%= close_stage_button(@season_team) %>
    </div>

    <div class="bg-body-tertiary border-bottom py-2 px-3 small text-muted d-flex align-items-center">
      <i class="fa-solid fa-layer-group me-2"></i>
      <span>Fases del torneo: gestiona el avance de cada fase y revisa sus partidos.</span>
    </div>    

    <%= render_tournament_stages(@tournament_data, @season_team) %>
  </div>

    <turbo-frame id="match_modal_frame"></turbo-frame>
    <turbo-frame id="next_stage_modal"></turbo-frame>
</div>
