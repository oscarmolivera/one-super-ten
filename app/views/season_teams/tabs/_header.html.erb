<div class="container mt-4">
  <div class="d-flex align-items-center justify-content-center mb-3 gap-3">
    <%= display_cup_logo(tournament_data[:cup], class: "rounded shadow-sm", style: "height: 120px; width: 120px; object-fit: contain;") %>
    <h1 class="mb-0">
      Copa <%= tournament_data[:cup].name %>
      <small class="text-muted fs-6 d-block">
        <%= tournament_data[:cup].school.name %> | 
        <%= tournament_data[:cup].description %> |
        <%= tournament_data[:cup].location %>
      </small>
      <small>
        <span>
          <%= tournament_data[:tournament].name %>
          <div class="badge badge-danger"><%= tournament_data[:category].sub_name %></div>
        </span>
        <% unless @season_team.active %>
          <h2 class="bg-gradient-danger-dark text-lighter blockquote blockquote-reverse">FINALIZADO </h2>
        <% end %>
      </small>
    </h1>
  </div>
</div>
<%#= tournament_data[:tournament].id %>