<div class="tab-pane active <%= 'inactive-team bg-light opacity-50 season-ended-pattern' unless @season_team.active %>" id="season-team" role="tabpanel" <%= 'aria-disabled="true"' unless @season_team.active %>>
  <!-- Inline SVG Pattern for Inactive Teams -->
  <% unless @season_team.active %>
      <svg width="0" height="0" style="position: absolute; z-index: -1;">
        <defs>
          <pattern id="tournament-finished-pattern" x="0" y="0" width="200" height="100" patternUnits="userSpaceOnUse">
            <text x="10" y="50" font-size="18" fill="#6c757d" fill-opacity="0.15" transform="rotate(-45 10 50)" font-family="Arial, sans-serif" text-anchor="start">
              Torneo Finalizado
            </text>
          </pattern>
        </defs>
      </svg>
    <% end %>

  <div class="p-5">
    <div class="container mt-4">
      <div class="row">
        <div class="col-md-6">
          <div class="card mb-4 shadow-sm">
            <div class="card-body">
              <% if @tournament_data[:players].any? %>
                <ul class="list-group list-group-flush <%= 'bg-secondary-subtle' unless @season_team.active %>">
                  <li class="list-group-item">
                    <div class="row text-center fw-semibold">
                      <div class="col-3 text-start">Nombre</div>
                      <div class="col-3">Dorsal</div>
                      <div class="col-3">Posición</div>
                      <div class="col-3">Origen</div>
                    </div>
                  </li>
                  <% @tournament_data[:players].each do |st_player| %>
                    <% origin = player_origin(st_player) %>
                    <li class="list-group-item <%= row_class_for(origin) %>">
                      <div class="row text-center align-items-center">
                        <div class="col-3 text-start">
                          <% if (icon = icon_for(origin)) %>
                            <i class="fa-solid <%= icon %> me-1"></i>
                          <% end %>
                          <%= st_player.player&.full_name || ExternalPlayer.find(st_player.external_player_id).full_name %>
                        </div>
                        <div class="col-3">
                          <span class="badge text-dark px-3 py-2 fw-bold"><%= st_player.jersey_number %></span>
                        </div>
                        <div class="col-3">
                          <span class="badge text-dark px-3 py-2"><%= st_player.position.capitalize %></span>
                        </div>
                        <div class="col-3">
                          <% categoria = st_player_category(st_player) %>
                          <% if categoria.present? %>
                            <span class="<%= badge_class_for(origin)%>">
                              <div><small><%= st_list_label(st_player) %></small></div>
                              <div><strong><%= categoria %></strong></div>
                            </span>
                          <% else %>
                            <span class="<%= badge_class_for(origin)%>">
                              <div><small><%= st_list_label(st_player) %></small></div>
                              <div><strong><%= st_player_origin_label(st_player) %></strong></div>
                            </span>
                          <% end %>
                        </div>
                      </div>
                    </li>
                  <% end %>
                </ul>
              <% else %>
                <div class="alert alert-info">No hay jugadores seleccionados de la categoría.</div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Technical Staff Section -->
        <div class="col-md-6">
          <div class="card mb-4 shadow-sm">
            <div class="card-body <%= 'bg-secondary-subtle' unless @season_team.active %>">
              <h5 class="card-title">Personal Técnico</h5>
              <p class="card-text">
                <strong>Entrenador:</strong> <%= @tournament_data[:coach].full_name || 'No asignado' %><br>
                <strong>Asistente:</strong> <%= @tournament_data[:assistant].full_name || 'No asignado' %><br>
                <strong>Delegado:</strong> <%= @tournament_data[:team_assistant].full_name || 'No asignado' %><br>
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Status Alert for Inactive Teams -->
      <% unless @season_team.active %>
        <div class="alert alert-warning mt-3" role="alert">
          <i class="bi bi-trophy-fill me-2"></i> Torneo finalizado (participación inactiva).
        </div>
      <% end %>
    </div>
  </div>
</div>
<style>
  .season-ended-pattern {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='100'><rect width='100%' height='100%' fill='url(%23tournament-finished-pattern)'/></svg>");
    background-repeat: repeat;
    background-size: 200px 100px;
    position: relative;
  }
  .inactive-team .list-group-item {
    background-color: transparent; /* Allow pattern to show through */
  }
  .inactive-team .card-body {
    background-color: transparent; /* Allow pattern to show through card body */
  }
</style>