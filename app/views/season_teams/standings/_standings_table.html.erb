<turbo-frame id="standings_<%= tournament_data[:tournament].id %>">
  <div class="row">
    <div class="col-md-6">
      <div class="nav-tabs-custom">
				<ul class="nav nav-pills mb-5">
					<li class=" nav-item"> <a href="#elimination" class="nav-link active" data-bs-toggle="tab" aria-expanded="false">Eliminatorias</a> </li>
					<li class=" nav-item"> <a href="#cup" class="nav-link" data-bs-toggle="tab" aria-expanded="false">Copa</a> </li>
				</ul>

				<div class="tab-content">
					<div class="active tab-pane" id="elimination">
            <div class="container mt-5">
              <div class="card shadow-sm">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center standings-header">
                  <h2 class="mb-0">Tabla de Clasificación</h2>
                </div>
                <div class="card-body">
                  <table class="table table-striped table-hover">
                    <thead class="table-dark">
                      <tr>
                        <th class="fw-light" scope="col">#</th>
                        <th class="fw-light" scope="col" class="w-55">Equipo</th>  <%# Wider team column %>
                        <th class="fw-light" scope="col">Pts</th>
                        <th class="fw-light" scope="col">PJ</th>
                        <th class="fw-light" scope="col">PG</th>
                        <th class="fw-light" scope="col">PE</th>
                        <th class="fw-light" scope="col">PP</th>
                        <th class="fw-light" scope="col">GF</th>
                        <th class="fw-light" scope="col">GC</th>
                        <th class="fw-light" scope="col">Dif</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% if tournament_data[:standings].present? %>
                        <% tournament_data[:standings].each do |standing| %>
                          <% is_inactive_rival = standing.standable.is_a?(Rival) && !standing.standable.active? %>
                          <tr class="<%= 'inactive-rival' if is_inactive_rival %>">
                            <th scope="row"><%= standing.position %></th>
                            <td class="text-nowrap w-55">
                              <%= standing.standable.name %>
                              <% if is_inactive_rival %>
                                <span class="badge bg-secondary ms-2">Inactivo</span>
                              <% end %>
                            </td>  <%# Prevent wrapping in team name %>
                            <td><%= standing.points %></td>
                            <td><%= standing.played %></td>
                            <td><%= standing.wins %></td>
                            <td><%= standing.draws %></td>
                            <td><%= standing.losses %></td>
                            <td><%= standing.goals_for %></td>
                            <td><%= standing.goals_against %></td>
                            <td class="<%= standing.goal_difference >= 0 ? 'text-success' : 'text-danger' %>">
                              <%= standing.goal_difference >= 0 ? "+#{standing.goal_difference}" : standing.goal_difference %>
                            </td>
                          </tr>
                        <% end %>
                      <% else %>
                        <tr>
                          <td colspan="10" class="text-center">No standings available.</td>  <%# Updated colspan to 10 %>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              </div>
              <div class="card shadow-sm mt-3">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                  <h2 class="mb-0">Resultados de Otros Partidos</h2>
                  <button type="button" class="btn btn-primary" 
                    data-controller="modal-loader"
                    data-modal-loader-url-value="<%= new_external_match_path(@season_team) %>"
                    data-modal-loader-target-frame-value="#external-match-modal-frame"
                    data-action="click->modal-loader#load">
                    Agregar Resultado
                  </button>
                </div>
              </div>
              <turbo-frame id="external-match-modal-frame"></turbo-frame>
            </div>            
					</div>
          <div class="tab-pane" id="cup">
            <div class="container mt-5">
            </div>
          </div>
				</div>
			</div>
    </div>
    <div class="col-md-6">
      <div class="row">
        <div class="container mt-1">
            <div class="card shadow-sm">
              <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h2 class="mb-0">Estadisticas</h2>
              </div>
              <div class="card-body">
                <table class="table table-striped table-hover">
                  <thead class="table-dark">
                    <tr>
                      <th scope="col">Player</th>
                      <th scope="col">Goals</th>
                      <th scope="col">Assists</th>
                      <th scope="col">Yellow Cards</th>
                      <th scope="col">Keepers Blocks</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td>Player 1</td>
                      <td>12</td>
                      <td>5</td>
                      <td class="text-warning">2</td>
                      <td>8</td>
                    </tr>
                    <tr>
                      <td>Player 2</td>
                      <td>9</td>
                      <td>3</td>
                      <td class="text-warning">1</td>
                      <td>5</td>
                    </tr>
                    <tr>
                      <td>Player 3</td>
                      <td>7</td>
                      <td>4</td>
                      <td class="text-warning">0</td>
                      <td>3</td>
                    </tr>
                    <tr>
                      <td>Player 4</td>
                      <td>4</td>
                      <td>2</td>
                      <td class="text-warning">3</td>
                      <td>2</td>
                    </tr>
                    <tr>
                      <td>Player 5</td>
                      <td>2</td>
                      <td>1</td>
                      <td class="text-warning">1</td>
                      <td>1</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
      </div>
    </div>
  </div>
</div>
<style>
  /* app/assets/stylesheets/standings.scss */
  .standings-header {
    background-color: #343a40 !important; // Dark gray from image
    border-bottom: 2px solid #17a2b8; // Teal accent
  }

  .badge.bg-primary {
    background-color: #17a2b8 !important; // Teal badge
  }

  .table {
    --bs-table-bg: #f8f9fa; // Light background
    --bs-table-striped-bg: #e9ecef; // Striped row color
    --bs-table-striped-color: #212529;
    --bs-table-hover-bg: #dee2e6; // Hover effect
  }

  .table-dark {
    background-color: #343a40; // Dark header
    color: #fff;
  }

  .table td, .table th {
    vertical-align: middle;
  }

  .text-success {
    color: #28a745 !important; // Green for positive GD
  }

  .text-danger {
    color: #dc3545 !important; // Red for negative GD
  }

  // Optional: Add team-specific styling (e.g., top 3 highlighted)
  .table tbody tr:nth-child(-n+3) {
    background-color: #e3f2fd; // Light blue for top 3
    font-weight: 500;
  }

  // Styling for inactive rivals
  .table tbody tr.inactive-rival {
    filter: grayscale(100%);
    opacity: 0.7;
    background-color: #f8f9fa;
  }

  .table tbody tr.inactive-rival:hover {
    filter: grayscale(80%);
    opacity: 0.8;
  }

  .table tbody tr.inactive-rival td,
  .table tbody tr.inactive-rival th {
    color: #6c757d;
  }

  .badge.bg-secondary {
    font-size: 0.7em;
    padding: 0.25em 0.5em;
  }
</style>